{
  "expo": {
    "name": "Hap pas Hapi",
    "slug": "hap-pas-hapi",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "happashapi",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./logo_hap_pas_hapi_8K-1.png",
        "backgroundColor": "#FFFFFF"
      },
      "icon": "./logo_hap_pas_hapi_8K-1.png",
      "package": "com.happashapi.gjermanisht"
    },
    "web": {
      "bundler": "metro"
    },
    "icon": "./logo_hap_pas_hapi_8K-1.png"
  }
}
